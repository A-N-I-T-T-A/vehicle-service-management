      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status update succeeds when transition is allowed\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response contains updated status\", function () { pm.expect(pm.response.json().message).to.have.property(\"status\"); });"
            ]
          }
        }
      ]
    },
