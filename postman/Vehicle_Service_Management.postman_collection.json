  "item": [
    {
      "name": "Get logged-in user",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "token {{api_key}}:{{api_secret}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/method/frappe.auth.get_logged_user",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "method",
            "frappe.auth.get_logged_user"
          ]
        },
        "description": "Checks the authenticated Frappe user. Configure api_key and api_secret in collection variables."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Request succeeds\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Logged-in user is returned\", function () { pm.expect(pm.response.json()).to.have.property(\"message\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Create booking - valid",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "token {{api_key}}:{{api_secret}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/method/vehicle_service.api.create_service_booking",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "method",
            "vehicle_service.api.create_service_booking"
          ]
        },
        "description": "Use a valid customer, vehicle belonging to that customer, a current/future booking date, and a valid service type.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer\": \"{{customer}}\",\n  \"vehicle\": \"{{vehicle}}\",\n  \"booking_date\": \"{{booking_date}}\",\n  \"service_type\": \"{{service_type}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Booking creation succeeds\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "const json = pm.response.json();",
              "if (json.message && json.message.name) { pm.collectionVariables.set(\"booking_name\", json.message.name); }",
              "pm.test(\"Response includes booking name and status\", function () { pm.expect(json.message).to.have.property(\"name\"); pm.expect(json.message).to.have.property(\"status\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Get service booking - valid",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "token {{api_key}}:{{api_secret}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/method/vehicle_service.api.get_service_booking?name={{booking_name}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "method",
            "vehicle_service.api.get_service_booking"
          ],
          "query": [
            {
              "key": "name",
              "value": "{{booking_name}}",
              "description": "Name returned by Create booking - valid"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Booking retrieval succeeds\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response includes booking details\", function () { const json = pm.response.json(); pm.expect(json.message).to.have.property(\"name\"); pm.expect(json.message).to.have.property(\"status\"); });"
            ]
          }
        }
      ]
    },
